{
  "name": "pv-iot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @pv/db migrate",
    "db:generate": "pnpm --filter @pv/db generate",
    "db:migrate:dev": "pnpm --filter @pv/db migrate:dev",
    "db:seed:demo": "pnpm --filter @pv/worker seed:demo",
    "eval:alerts": "pnpm --filter @pv/worker eval:alerts",
    "eval:assistant": "pnpm --filter @pv/worker eval:assistant",
    "admin:create-superadmin": "pnpm --filter @pv/api admin:create-superadmin",
    "coverage:core": "vitest run --project @pv/core --coverage --coverage.include='src/**' --coverage.exclude='**/*.test.ts' --coverage.reporter=text-summary --coverage.thresholds.lines=90"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
