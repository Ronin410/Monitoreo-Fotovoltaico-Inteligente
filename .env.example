# Variables de entorno de PV-IoT (ver specs/01-arquitectura.md).
# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
# api y worker validan todo al arrancar y fallan con un mensaje claro si falta algo.

NODE_ENV=development
# Puerto HTTP (Render lo asigna en producción). api: 4000, web: 3000.
PORT=

# --- Base de datos -----------------------------------------------------------
# Rol de aplicación: sin BYPASSRLS y sin ser dueño de las tablas (ver specs/02).
DATABASE_URL=postgres://pv_app:pv_app@localhost:5432/pv_iot

# --- URLs públicas -----------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Autenticación -----------------------------------------------------------
# Mínimo 32 bytes. Genera con: openssl rand -base64 48
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# --- Cifrado de credenciales de inversor (AES-256-GCM) ------------------------
# Exactamente 32 bytes en base64. Genera con: openssl rand -base64 32
CREDENTIALS_ENC_KEY=
CREDENTIALS_KEY_VERSION=1

# --- IA ----------------------------------------------------------------------
# anthropic | mock (mock: proveedor simulado para desarrollo y pruebas; prohibido en producción)
LLM_PROVIDER=anthropic
# Obligatoria si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_CHAT=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5

# --- Clima -------------------------------------------------------------------
# open-meteo | synthetic (synthetic: sin red, para desarrollo y pruebas)
WEATHER_PROVIDER=open-meteo
# Opcional según el proveedor
WEATHER_API_KEY=

# --- Correo ------------------------------------------------------------------
# resend | smtp (obligatoria)
EMAIL_PROVIDER=smtp
EMAIL_FROM=PV-IoT <no-reply@localhost>
# Obligatoria si EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Obligatorias (host y puerto) si EMAIL_PROVIDER=smtp. Para desarrollo sirve Mailpit (puerto 1025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Archivos (logos y PDFs) -------------------------------------------------
# local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
# Obligatorias si STORAGE_PROVIDER=s3 (S3 compatible: Cloudflare R2 o S3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Otros -------------------------------------------------------------------
# true en staging y demo
SIMULATOR_ENABLED=true
DEFAULT_TIMEZONE=America/Mazatlan
